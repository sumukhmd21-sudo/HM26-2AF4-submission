# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database (Supabase PostgreSQL)
DATABASE_URL=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Gemini
# All model names are read from env at runtime. The values below are the
# currently-published Gemini lineup (Jan 2026). Replace with whatever your
# API key actually has access to.
GEMINI_API_KEY=

# Primary analysis (text + image) — current stable
GEMINI_ANALYSIS_MODEL=gemini-3.6-flash

# Audio transcription — general-purpose audio-capable model.
# (The native gemini-*-transcribe* variants from the spec do not exist on
# the API yet. gemini-3.6-flash reliably handles audio input + JSON output.)
GEMINI_TRANSCRIBE_MODEL=gemini-3.6-flash
GEMINI_TRANSCRIBE_LIVE_MODEL=gemini-3.6-flash

# Realtime voice conversation
GEMINI_LIVE_MODEL=gemini-3.6-flash

# Text-to-speech
# Gemini ships dedicated TTS models (not the regular flash/pro models).
# Supported names: gemini-2.5-flash-preview-tts, gemini-2.5-pro-preview-tts,
# gemini-3.1-flash-tts-preview. The "preview" suffix is required.
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts

# Geocoder
GEOCODER_PROVIDER=nominatim
GEOCODER_API_KEY=

# Location
# Maximum acceptable GPS accuracy (metres). Desktop browsers report
# 100-1000 m, indoor phones often 100-500 m. The previous 50 m default
# rejected almost every real user; 2000 m is a sensible ceiling for a
# city-scale complaint portal where the polygon check is the real guard.
LOCATION_MAX_ACCURACY_METERS=2000

# Storage
STORAGE_BUCKET=complaints

# Jurisdiction
MYSURU_SERVICE_AREA_SOURCE=config
